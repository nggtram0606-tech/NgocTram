#!name=Locket iOS Debug (Read-only)
#!desc=Inspect RevenueCat subscriber response metadata; does not modify purchases

[Script]
Locket RevenueCat Inspector = type=http-response,pattern=^https://api\.revenuecat\.com/v1/subscribers/[^?]+,requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/YOUR_GITHUB_USERNAME/Locket-iOS-Debug/main/Scripts/RevenueCat.js

[MITM]
hostname = %APPEND% api.revenuecat.com
