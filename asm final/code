import java.util.*;

class Student {
    String id;
    String name;
    double score;
    public Student(String id, String name, double score) {
        this.id = id;
        this.name = name;
        this.score = score;
        }
}
public class StudentManager {
    static List<Student> students = new ArrayList<>();
    
public static void addStudent(String id, String name, double score) {
    if (id == null || id.trim().isEmpty()) {
         System.out.println("Error: Invalid ID!");
        return;
        }
        if (name == null || name.trim().isEmpty()) {
            System.out.println("Error: Invalid name!");
             return;
             }
        if (score < 0 || score > 10) {
            System.out.println("Error: The score must be between 0 and 10!");
            return;
        }
    for (Student s : students) {
        if (s.id.equals(id)) {
            System.out.println("Error: The ID already exists!");
            return;
        }
    }
    students.add(new Student(id, name, score));
}
public static void sortStudents() {
    Collections.sort(students, (a, b) -> Double.compare(b.score, a.score));
}
public static Student searchStudent(String id) {
    for (Student s : students) {
        if (s.id.equals(id)) {
            return s;
        }
    }
    return null;
}

public static void displayStudents() {
    if (students.isEmpty()) {
        System.out.println("Empty list!");
        return;
    }
    int rank = 1;
    for (Student s : students) {
        System.out.println(rank + ". " + s.id + " - " + s.name + " - " + s.score);
        rank++;
        }
    }
public static void main(String[] args) {
    addStudent("S1", "Ha Vy", 8.5);
    addStudent("S2", "Tung", 9.2);
    addStudent("S3", "Minh", 7.8);
    sortStudents();
    displayStudents();
    }
}