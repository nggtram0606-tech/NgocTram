#!name=Locket Gold Inspector
#!desc=Read-only inspection of Locket subscription metadata
#!category=Debug

[Script]
Locket Gold Inspector = type=http-response,pattern=^https://api\.revenuecat\.com/v1/subscribers/[^?]+,requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/YOUR_GITHUB_USERNAME/YOUR_REPOSITORY/main/Scripts/Locket-Gold-Inspector.js

[MITM]
hostname = %APPEND% api.revenuecat.com
